.~lock.*#
*.tmp
/node_modules/
/web/node_modules
/web/dist/*
!/web/dist/.gitkeep
/bin/
.env
*.local

# Vídeos y herramientas locales de los recorridos; sólo se guardan los publicados en videos/.
