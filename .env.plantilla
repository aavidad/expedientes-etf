# Copiar a .env (no versionado), permiso 0600, y rellenar contraseñas distintas.
ETF_INSTALADOR_CONTRASENA=
ETF_MIGRADOR_CONTRASENA=
ETF_APP_CONTRASENA=
ETF_COPIA_CONTRASENA=
# Opcional: sin contraseña, el rol existe pero no admite conexión.
ETF_CALCULO_MEMORIA_CONTRASENA=
ETF_HTTP_PUERTO=18083
ETF_RED_SUBRED=10.250.4.0/28
ETF_ENTRADA_SUBRED=10.250.4.16/28
